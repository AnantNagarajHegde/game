/* Paridhwani visual review: one palette and one rule per component.
   Candidate direction; the durable design template follows user approval. */
.root {
    --ink: rgb(19,24,25);
    --panel: rgb(25,31,32);
    --raised: rgb(37,44,44);
    --line: rgb(67,75,74);
    --ivory: rgb(242,237,223);
    --muted: rgb(181,190,186);
    --brass: rgb(213,181,121);
    --brass-ink: rgb(28,30,27);
    --blue: rgb(36,112,225);
    color: var(--ivory); font-size: 16px; -unity-text-generator: advanced;
}
Label { white-space: normal; }
.top { position: absolute; left: 36px; top: 28px; right: 36px; flex-direction: row; justify-content: space-between; }
.brand { font-size: 22px; letter-spacing: 4px; color: var(--ivory); }
.tagline { font-size: 11px; margin-top: 5px; color: var(--brass); letter-spacing: 2px; }
.place { align-items: flex-end; padding: 10px 16px; background-color: rgba(19,24,25,.92); border-right-width: 2px; border-right-color: var(--brass); border-radius: 3px; }
.place .eyebrow { margin-bottom: 2px; }
.eyebrow { font-size: 12px; letter-spacing: 1.6px; color: var(--brass); margin-bottom: 12px; }
.small { font-size: 13px; color: var(--muted); margin-top: 5px; white-space: normal; }
.task { position: absolute; left: 36px; bottom: 34px; width: 370px; max-width: 34%; padding: 18px 22px; background-color: rgba(19,24,25,.94); border-left-width: 2px; border-left-color: var(--brass); border-radius: 3px; }
.task .eyebrow { font-size: 11px; margin-bottom: 10px; }
.objective { font-size: 19px; margin-bottom: 10px; color: var(--ivory); }
.route-hint { color: var(--brass); font-size: 12px; }
.save-status { font-size: 11px; color: rgb(151,166,158); margin-top: 12px; }
.controls { position: absolute; bottom: 34px; right: 36px; max-width: 48%; align-items: flex-end; padding: 10px 14px; background-color: rgba(19,24,25,.88); border-radius: 3px; }
.controls .small { font-size: 12px; margin-top: 3px; }
.prompt { position: absolute; bottom: 174px; max-width: 88%; align-self: center; flex-direction: row; align-items: center; padding: 10px 18px; background-color: var(--ink); border-width: 1px; border-color: var(--brass); border-radius: 5px; }
.prompt-prefix { display: none; }
.keycap { min-width: 32px; min-height: 32px; padding: 5px 10px; margin-right: 12px; background-color: var(--brass); color: var(--brass-ink); border-radius: 3px; -unity-text-align: middle-center; flex-shrink: 0; }
.prompt-text { font-size: 16px; flex-shrink: 1; }
.modal-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; justify-content: center; align-items: center; background-color: rgba(6,12,15,.48); }
.paper, .notebook { width: 680px; max-width: 92%; max-height: 85%; padding: 28px 32px; background-color: var(--panel); border-width: 1px; border-color: var(--line); border-top-width: 2px; border-top-color: var(--brass); border-radius: 6px; }
.notebook { width: 820px; }
.title { font-size: 30px; margin-top: 4px; margin-bottom: 18px; color: var(--ivory); }
.body { font-size: 16px; white-space: normal; margin-top: 6px; margin-bottom: 20px; color: rgb(221,224,215); }
.row { flex-direction: row; justify-content: space-between; align-items: center; }
.row > .eyebrow { flex-shrink: 1; }
.button, .choice, .evidence-answer { background-color: var(--raised); border-width: 1px; border-color: var(--line); border-radius: 4px; color: var(--ivory); white-space: normal; }
.button { min-height: 42px; padding: 11px 16px; margin: 0 0 9px 0; font-size: 16px; -unity-text-align: middle-left; }
.button:hover, .choice:hover, .evidence-answer:hover { background-color: rgb(51,59,56); border-color: var(--brass); }
.button:focus, .choice:focus, .evidence-answer:focus, .quiet-button:focus { background-color: rgb(54,61,55); border-color: var(--brass); color: var(--ivory); }
.primary-button { background-color: var(--brass); border-color: var(--brass); color: var(--brass-ink); }
.primary-button:hover, .primary-button:focus { background-color: rgb(237,210,158); color: var(--brass-ink); border-color: var(--ivory); }
.button:disabled, .quiet-button:disabled { opacity: .42; }
.quiet-button { min-height: 32px; padding: 7px 12px; margin: 0 0 6px 0; background-color: rgba(0,0,0,0); border-width: 1px; border-color: rgba(181,190,186,.2); border-radius: 4px; color: var(--muted); font-size: 13px; white-space: normal; -unity-text-align: middle-left; }
.quiet-button:hover { background-color: var(--raised); border-color: var(--brass); color: var(--ivory); }
.section-title { font-size: 12px; letter-spacing: 1.5px; color: var(--brass); margin-top: 20px; margin-bottom: 10px; }
.kannada { font-size: 25px; margin-bottom: 5px; white-space: normal; }
.roman, .word-ro { font-size: 16px; color: var(--brass); margin-top: 4px; margin-bottom: 5px; }
.meaning { font-size: 15px; color: var(--muted); margin-top: 4px; }
.speech { padding-bottom: 14px; margin-bottom: 12px; border-bottom-width: 1px; border-bottom-color: var(--line); }
.choices { flex-direction: row; }
.choice { flex-grow: 1; flex-basis: 0; margin-right: 9px; padding: 12px; flex-direction: row; }
.choice-number { font-size: 12px; color: var(--brass); margin-right: 10px; }
.choice-lines { flex-grow: 1; flex-shrink: 1; }
.choice-kn { font-size: 20px; white-space: normal; }
.choice-ro, .choice-en { font-size: 14px; white-space: normal; margin-top: 5px; }
.choice-ro { color: var(--brass); }
.choice-en { color: var(--muted); }
.aids { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 14px; flex-wrap: wrap; }
.word-row { flex-direction: row; padding: 12px 0; border-bottom-width: 1px; border-bottom-color: var(--line); }
.word-kn { font-size: 24px; min-width: 220px; }
.word-row > VisualElement { flex-shrink: 1; }
.notebook-scroll, .evidence-scroll { flex-grow: 1; flex-shrink: 1; min-height: 48px; }
.unity-scroll-view__content-container { padding-right: 10px; }
Toggle { flex-direction: row; align-items: center; margin-top: 9px; margin-bottom: 9px; font-size: 14px; }
.unity-toggle__input { width: 20px; min-width: 20px; height: 20px; flex-basis: 20px; flex-grow: 0; flex-shrink: 0; margin-right: 8px; border-width: 1px; border-color: var(--muted); border-radius: 3px; background-color: var(--ink); }
.unity-toggle__input:checked { background-color: var(--brass); border-color: var(--brass); }
.unity-toggle__checkmark { width: 12px; height: 12px; }
Slider { margin-top: 13px; margin-bottom: 13px; }
.unity-base-slider__input { min-width: 120px; min-height: 22px; flex-grow: 1; }
.unity-base-slider__tracker { background-color: var(--line); height: 4px; top: 9px; border-radius: 2px; }
.unity-base-slider__dragger { width: 16px; height: 20px; background-color: var(--brass); border-radius: 4px; }
.unity-base-field__label { color: var(--ivory); min-width: 160px; white-space: normal; }
.unity-base-popup-field__input, .unity-text-field__input { background-color: var(--ink); color: var(--ivory); border-width: 1px; border-color: var(--line); border-radius: 4px; padding: 8px 10px; }
DropdownField, TextField { margin-top: 8px; margin-bottom: 10px; }
Toggle:focus, Slider:focus, DropdownField:focus, TextField:focus { border-width: 1px; border-color: var(--brass); border-radius: 4px; }
.unity-scroller--vertical { width: 10px; margin-left: 6px; }
.unity-scroller .unity-base-slider { margin: 0; }
.unity-scroller .unity-base-slider__input { min-width: 6px; min-height: 0; }
.unity-scroller .unity-base-slider__tracker { background-color: rgba(181,190,186,.08); border-width: 0; width: 4px; height: auto; top: 0; }
.unity-scroller .unity-base-slider__dragger { background-color: rgb(103,117,110); border-width: 0; width: 6px; min-height: 24px; border-radius: 3px; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
.controller-help { position: absolute; bottom: 4px; left: 24px; right: 24px; padding: 5px 10px; font-size: 12px; color: var(--muted); background-color: var(--ink); white-space: normal; -unity-text-align: middle-center; border-radius: 3px; }
/* Title is a quiet left column over the live world. */
.title-modal { align-items: flex-start; background-color: rgba(8,15,18,.2); }
.title-card { margin-left: 5%; width: 550px; padding: 34px; border-top-width: 0; border-left-width: 2px; border-left-color: var(--brass); background-color: rgba(19,24,25,.97); }
.title-card .brand { font-size: 34px; letter-spacing: 4px; margin-top: 0; margin-bottom: 12px; }
.title-rule { width: 54px; height: 2px; background-color: var(--brass); margin-bottom: 14px; flex-shrink: 0; }
.title-card .title { font-size: 25px; margin-bottom: 10px; }
.title-card .body { font-size: 14px; margin-bottom: 18px; }
.title-card .quiet-button { border-color: rgba(0,0,0,0); padding-left: 4px; }
.title-card .quiet-button:focus, .title-card .quiet-button:hover { border-color: var(--brass); }
.title-card .button { min-height: 42px; padding: 10px 14px; margin-bottom: 7px; }
.title-actions { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; margin-top: 12px; padding-top: 10px; border-top-width: 1px; border-top-color: var(--line); }
.title-actions .quiet-button { margin-right: 24px; }
.title-location { flex-shrink: 0; font-size: 10px; letter-spacing: 2px; color: var(--brass); margin-top: 8px; }
.pause-actions { flex-direction: row; flex-wrap: wrap; justify-content: space-between; margin-bottom: 8px; }
.pause-actions > .button, .pause-actions > .quiet-button { width: 48%; min-height: 40px; }
/* Evidence and notebook share the same reading surface and fixed actions. */
.evidence-card { width: 900px; height: 84%; }
.evidence-card > .row, .evidence-card > .aids, .evidence-card > .small, .evidence-card > .button { flex-shrink: 0; }
.evidence-card > .aids { min-height: 30px; }
.evidence-card .title { font-size: 26px; margin-bottom: 12px; }
.ledger-entry { flex-direction: row; align-items: center; justify-content: space-between; margin: 10px 0; padding: 14px; background-color: var(--ink); border-left-width: 2px; border-left-color: var(--brass); border-radius: 4px; }
.ledger-writing { flex-grow: 1; flex-shrink: 1; }
.clock { width: 140px; height: 140px; flex-shrink: 0; position: relative; border-width: 2px; border-color: var(--brass); border-radius: 70px; margin: 4px 16px; }
.clock Label { position: absolute; font-size: 13px; color: var(--ivory); }
.clock-twelve { top: 4px; left: 56px; }
.clock-three { right: 9px; top: 56px; }
.clock-six { bottom: 5px; left: 61px; }
.clock-nine { left: 9px; top: 56px; }
.clock-minute { position: absolute; top: 25px; left: 67px; width: 2px; height: 43px; background-color: var(--ivory); }
.clock-hour { position: absolute; top: 68px; left: 66px; width: 4px; height: 29px; background-color: var(--brass); }
.clock-pin { position: absolute; top: 64px; left: 63px; width: 9px; height: 9px; border-radius: 5px; background-color: var(--ivory); }
.evidence-answer { flex-direction: row; align-items: center; padding: 8px 12px; margin: 4px 0; }
.evidence-card .choice-kn { font-size: 19px; }
.evidence-card .choice-ro, .evidence-card .choice-en { margin-top: 2px; }
.evidence-card .section-title { margin-top: 12px; margin-bottom: 7px; }
.schedule-row { flex-direction: row; align-items: center; padding: 10px 12px; border-bottom-width: 1px; border-bottom-color: var(--line); }
.route-number { width: 55px; font-size: 26px; color: var(--brass); }
.schedule-destination { flex-grow: 1; flex-shrink: 1; }
.schedule-time { font-size: 16px; color: var(--ivory); }
.feedback { color: rgb(244,199,133); font-size: 14px; margin: 12px 0; white-space: normal; }
.success { color: rgb(166,218,180); font-size: 15px; margin: 14px 0; white-space: normal; }
.bicycle-panel .body { margin-bottom: 10px; font-size: 15px; }
.bicycle-panel .kannada { font-size: 23px; }
.bicycle-panel .evidence-answer { padding: 5px 10px; flex-grow: 1; flex-basis: 0; margin-right: 8px; }
.bicycle-panel .aids { margin-top: 8px; }
.bicycle-panel .feedback { margin: 8px 0; }
#developer-display { margin-top: 24px; padding: 14px; background-color: var(--ink); border-radius: 4px; }
/* Solid black conversation, white NPC bubbles and blue player bubbles. */
.chat-modal { background-color: rgba(0,0,0,0); }
.conversation { position: absolute; top: 0; right: 0; bottom: 0; width: 40%; min-width: 320px; max-width: 620px; max-height: 100%; padding: 20px 22px 16px 22px; background-color: rgb(0,0,0); border-left-width: 1px; border-left-color: rgb(47,51,54); }
.dialogue-header { flex-shrink: 0; padding-bottom: 14px; margin-bottom: 16px; border-bottom-width: 1px; border-bottom-color: rgb(47,51,54); }
.speaker-avatar { width: 40px; height: 40px; margin-right: 12px; border-radius: 20px; background-color: var(--brass); color: var(--brass-ink); font-size: 19px; -unity-text-align: middle-center; flex-shrink: 0; }
.speaker-identity { flex-grow: 1; flex-shrink: 1; }
.speaker-name { font-size: 19px; color: rgb(255,255,255); }
.speaker-identity .eyebrow { font-size: 10px; color: var(--muted); margin-bottom: 0; margin-top: 3px; letter-spacing: 1px; }
.dialogue-header .quiet-button { flex-shrink: 0; margin-left: 8px; margin-bottom: 0; }
.dialogue-scroll { flex-grow: 1; flex-shrink: 1; min-height: 30px; }
.dialogue-scroll .unity-scroll-view__content-container { flex-shrink: 0; padding-right: 6px; }
.chat-message { max-width: 94%; margin-bottom: 14px; padding: 12px 15px; border-radius: 12px; flex-shrink: 0; }
.chat-player { align-self: flex-end; background-color: var(--blue); border-bottom-right-radius: 3px; }
.chat-npc { align-self: flex-start; background-color: rgb(255,255,255); border-bottom-left-radius: 3px; }
.chat-speaker { display: none; }
.chat-player .kannada, .chat-player .roman, .chat-player .meaning, .chat-player .chat-speaker { color: rgb(255,255,255); }
.chat-npc .kannada, .chat-npc .roman, .chat-npc .meaning, .chat-npc .chat-speaker { color: rgb(19,24,28); }
.chat-message .kannada { font-size: 22px; margin-bottom: 3px; }
.chat-message .roman, .chat-message .meaning { font-size: 15px; margin-top: 5px; }
.dialogue-composer { flex-shrink: 0; padding-top: 10px; border-top-width: 1px; border-top-color: rgb(47,51,54); }
.dialogue-composer TextField { flex-direction: column; margin: 0 0 8px 0; }
.dialogue-composer .unity-base-field__label { font-size: 11px; margin-bottom: 5px; color: var(--muted); }
.dialogue-composer .unity-text-field__input { min-height: 38px; font-size: 16px; border-radius: 6px; }
.chat-actions { flex-direction: row; justify-content: flex-end; }
.chat-actions .button, .chat-actions .quiet-button { min-height: 32px; padding: 5px 14px; margin: 0 0 4px 8px; font-size: 14px; }
.send-button { background-color: var(--blue); border-color: var(--blue); color: rgb(255,255,255); }
.send-button:hover, .send-button:focus { background-color: rgb(63,137,248); border-color: rgb(186,216,255); }
.conversation .dialogue-footer { flex-shrink: 0; flex-wrap: wrap; justify-content: flex-start; margin-top: 8px; padding-top: 5px; }
.dialogue-footer > * { margin-right: 12px; }
.dialogue-footer Toggle { font-size: 12px; margin-top: 4px; margin-bottom: 4px; }
.dialogue-footer .unity-base-field__label { min-width: 0; margin-right: 7px; }
.dialogue-footer .quiet-button { min-height: 26px; font-size: 11px; padding: 4px 7px; margin-bottom: 0; }
.dialogue-footer .unity-toggle__input { width: 16px; min-width: 16px; height: 16px; flex-basis: 16px; }
.keyboard-panel { padding-top: 8px; padding-bottom: 6px; background-color: var(--ink); border-top-width: 1px; border-top-color: var(--line); }
.keyboard-panel .button { min-height: 0; padding: 2px 6px; background-color: var(--raised); border-color: var(--line); border-radius: 4px; }
.keyboard-panel .button:hover, .keyboard-panel .keyboard-selected { background-color: var(--brass); border-color: var(--ivory); color: var(--brass-ink); }
#tea-keyboard-help { font-size: 12px; margin-top: 3px; }
.keyboard-open .dialogue-header { padding-bottom: 6px; margin-bottom: 6px; }
.keyboard-open .speaker-avatar, .keyboard-open .speaker-identity .eyebrow { display: none; }
.keyboard-open .speaker-name { font-size: 17px; }
.keyboard-open .dialogue-composer .unity-base-field__label { display: none; }
.keyboard-open #dialogue-tea-keyboard { display: none; }
.keyboard-open .dialogue-composer { padding-top: 4px; }
.keyboard-open .dialogue-composer TextField { margin-bottom: 4px; }
.keyboard-open .conversation .dialogue-footer { padding-top: 0; margin-top: 2px; }
/* Physical viewport classification is set by the UI, independent of panel scaling. */
.compact .top { left: 22px; right: 22px; top: 18px; }
.compact .brand { font-size: 20px; }
.compact .tagline { display: none; }
.compact .task { left: 22px; bottom: 22px; width: 340px; padding: 14px 18px; }
.compact .controls { right: 22px; bottom: 22px; padding: 8px 12px; }
.compact .controls .small { font-size: 12px; }
.compact .prompt { bottom: 160px; padding: 8px 14px; }
.compact .paper, .compact .notebook { padding: 20px 24px; }
.compact .title-card { padding: 24px 28px; }
.compact .title-card .brand { font-size: 30px; }
.compact .title-card .title { font-size: 23px; }
.compact .title-card .body { margin-bottom: 16px; }
.compact .conversation { padding: 12px 16px 10px 16px; width: 48%; min-width: 280px; }
.compact .dialogue-header { padding-bottom: 8px; margin-bottom: 10px; }
.compact .speaker-avatar { width: 34px; height: 34px; border-radius: 17px; }
.compact .chat-message { padding: 9px 12px; margin-bottom: 10px; }
.compact .dialogue-composer { padding-top: 6px; }
.compact .conversation .dialogue-footer { margin-top: 2px; padding-top: 0; }
